hcloud_token = "replace-with-hcloud-token"
tailscale_auth_key = "replace-with-tailscale-auth-key"
ssh_public_key = "ssh-ed25519 AAAA... your-key-comment"

# Replace with your current public IP, e.g. ["203.0.113.10/32"].
# This controls SSH and Dokploy panel access.
allowed_admin_cidrs = ["203.0.113.10/32"]
