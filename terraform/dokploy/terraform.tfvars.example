hcloud_token = "replace-with-hcloud-token"

# Optional. Leave empty if you want to manage the server through Dokploy first.
ssh_key_ids = []

# Optional. When set, cloud-init installs Tailscale and joins the server to your tailnet.
# Generate a reusable auth key in the Tailscale admin console.
enable_tailscale   = false
tailscale_auth_key = null

# Replace with your current public IP, e.g. ["203.0.113.10/32"].
allowed_admin_cidrs = ["203.0.113.10/32"]
