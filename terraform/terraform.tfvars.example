hcloud_token = "replace-with-hcloud-token"

# fsn1 = Falkenstein, Germany
# nbg1 = Nuremberg, Germany
location = "fsn1"

server_name = "personal-k8s-node-1"
server_type = "cpx12"
image       = "ubuntu-24.04"

# Replace with your current public IP, e.g. ["203.0.113.10/32"].
allowed_ssh_cidrs = ["203.0.113.10/32"]

# Option A: create/register a key from public key material.
ssh_public_key = "ssh-ed25519 AAAA..."

# Option B: use existing Hetzner key IDs/names instead and remove ssh_public_key.
# ssh_key_ids = ["my-existing-key"]
